# ══════════════════════════════════════════════════════
# SEGURIDAD
# ══════════════════════════════════════════════════════
Options -Indexes

<FilesMatch ".*\.(log|ini|htaccess)$">
    deny from all
</FilesMatch>

# ══════════════════════════════════════════════════════
# URL REWRITING (100% Portable Local/Producción)
# ══════════════════════════════════════════════════════
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Bloquea acceso directo a carpetas del sistema
    RewriteRule ^(app|helper|vendor|config|sql)/ - [F,L]

    # Permite acceso directo a la carpeta public (css, img)
    RewriteRule ^public/ - [L]

    # Condición general: Si no es un archivo ni una carpeta real, aplicar reglas
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # REGLA 1: Controlador y Método (ej: /login/validar -> controller=login & method=validar)
    RewriteRule ^([^/]+)/([^/]+)$ index.php?controller=$1&method=$2 [QSA,L]

    # Condición general repetida para la segunda regla
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # REGLA 2: Solo Controlador (ej: /home -> controller=home & method=index)
    # Acá estaba el error anterior: le agregamos "?controller=$1" para que envíe el dato
    RewriteRule ^(.*)$ index.php?controller=$1 [QSA,L]
</IfModule>