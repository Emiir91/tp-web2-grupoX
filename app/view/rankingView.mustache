<main class="pantalla-home">
    <div class="panel-home ranking-panel">
        <h2 class="ranking-title">⚡ Ranking Global Mensual ⚡</h2>

        <table class="ranking-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Jugador</th>
                    <th>Puntaje Total</th>
                </tr>
            </thead>
            <tbody>
                {{#ranking}}
                <tr {{#soy_yo}}class="fila-propia"{{/soy_yo}}>
                    <td>{{posicion}}</td>
                    <td>
                        <a href="{{url_perfil}}" class="link-jugador" title="Ver el perfil de {{usuario}}">{{usuario}}</a>
                        {{#soy_yo}}<span class="etiqueta-vos">vos</span>{{/soy_yo}}
                    </td>
                    <td>{{puntaje_total}} pts</td>
                </tr>
                {{/ranking}}
                {{^ranking}}
                <tr>
                    <td colspan="3" class="sin-datos">Todavía no hay partidas registradas este mes. ¡Sé el primero!</td>
                </tr>
                {{/ranking}}
            </tbody>
        </table>

        <p class="ayuda-ranking">Tocá el nombre de un jugador para ver su perfil.</p>

        <a href="{{base_url}}/lobby" class="btn-volver">← Volver al Lobby</a>
    </div>
</main>
