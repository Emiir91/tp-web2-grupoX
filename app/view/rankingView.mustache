<main class="pantalla-ranking">
    <div class="panel-ranking">
        <a href="{{base_url}}/lobby" class="btn-volver-lobby">← Volver al Lobby</a>

        <h2 class="titulo-ranking">⚡ Ranking <span>Global Mensual</span> ⚡</h2>

        <table class="tabla-ranking">
            <thead>
                <tr>
                    <th class="col-posicion">#</th>
                    <th>Jugador</th>
                    <th class="col-puntos">Puntaje</th>
                </tr>
            </thead>
            <tbody>
                {{#ranking}}
                <tr class="fila-jugador{{#soy_yo}} fila-propia{{/soy_yo}}">
                    <td class="col-posicion"><span class="posicion">{{posicion}}</span></td>
                    <td>
                        <a href="{{url_perfil}}" class="link-jugador" title="Ver el perfil de {{usuario}}">{{usuario}}</a>
                        {{#soy_yo}}<span class="etiqueta-vos">vos</span>{{/soy_yo}}
                    </td>
                    <td class="col-puntos">{{puntaje_total}} <small>pts</small></td>
                </tr>
                {{/ranking}}
                {{^ranking}}
                <tr>
                    <td colspan="3" class="sin-datos">Todavía no hay partidas registradas este mes. ¡Sé el primero!</td>
                </tr>
                {{/ranking}}
            </tbody>
        </table>

        <p class="ayuda-ranking">Tocá el nombre de un jugador para ver su perfil.</p>
    </div>
</main>
