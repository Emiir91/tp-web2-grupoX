<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - Juego de Preguntas</title>
</head>
<body>

<h2>Crear una Cuenta</h2>

<!-- El formulario envía los datos por el método POST (seguro) hacia nuestro Controlador -->
<!-- El atributo enctype es OBLIGATORIO para poder subir la foto de perfil -->
<form action="/registro/procesar" method="POST" enctype="multipart/form-data">

    <label for="nombre_completo">Nombre Completo:</label>
    <input type="text" id="nombre_completo" name="nombre_completo" required><br><br>

    <label for="anio_nacimiento">Año de Nacimiento:</label>
    <input type="number" id="anio_nacimiento" name="anio_nacimiento" min="1900" max="2026" required><br><br>

    <label for="sexo">Sexo:</label>
    <select id="sexo" name="sexo" required>
        <option value="">Seleccione...</option>
        <option value="Masculino">Masculino</option>
        <option value="Femenino">Femenino</option>
        <option value="Prefiero no cargarlo">Prefiero no cargarlo</option>
    </select><br><br>

    <!-- Estos campos luego los conectaremos con el mapa de Leaflet interactivo -->
    <label for="pais">País:</label>
    <input type="text" id="pais" name="pais" placeholder="Clic en el mapa..." readonly required><br><br>

    <label for="ciudad">Ciudad:</label>
    <input type="text" id="ciudad" name="ciudad" placeholder="Clic en el mapa..." readonly required><br><br>

    <!-- Contenedor para el mapa interactivo -->
    <div id="mapa-registro">
        <p>(Acá irá el mapa interactivo)</p>
    </div>

    <label for="mail">Correo Electrónico:</label>
    <input type="email" id="mail" name="mail" required><br><br>

    <label for="nombre_usuario">Nombre de Usuario:</label>
    <input type="text" id="nombre_usuario" name="nombre_usuario" required><br><br>

    <label for="contrasenia">Contraseña:</label>
    <input type="password" id="contrasenia" name="contrasenia" required><br><br>

    <label for="repetir_contrasenia">Repetir Contraseña:</label>
    <input type="password" id="repetir_contrasenia" name="repetir_contrasenia" required><br><br>

    <label for="foto_perfil">Foto de Perfil:</label>
    <input type="file" id="foto_perfil" name="foto_perfil" accept="image/*" required><br><br>

    <button type="submit">Registrarme</button>
</form>

</body>
</html>