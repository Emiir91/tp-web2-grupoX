<main class="pantalla-editor">
    <div class="panel-editor panel-amplio">
        <h2 class="titulo-editor">Agregar pregunta</h2>
        {{#es_admin}}<p class="aviso-edicion">Como administrador, la pregunta se crea activa y entra al juego en el momento.</p>{{/es_admin}}
        {{^es_admin}}<p class="aviso-edicion">La pregunta se crea inactiva y queda pendiente de aprobación del administrador.</p>{{/es_admin}}

        {{#alerta_error}}<div class="alerta alerta-error">{{alerta_error}}</div>{{/alerta_error}}

        <form action="{{base_url}}/editor/guardarPregunta" method="POST" class="form-editor">
            <label class="label-editor">
                Pregunta
                <textarea name="texto_pregunta" rows="2" required maxlength="500"></textarea>
            </label>

            <div class="fila-editor">
                <label class="label-editor">
                    Categoría
                    <select name="categoria" class="select-categoria" required>
                        <option value="">Seleccioná una categoría</option>
                        {{#categorias}}
                        <option value="{{nombre}}">{{nombre}}</option>
                        {{/categorias}}
                        <option value="__nueva__">+ Nueva categoría</option>
                    </select>
                </label>
                <label class="label-editor">
                    Dificultad
                    <select name="dificultad">
                        <option value="facil">Fácil</option>
                        <option value="intermedio">Intermedio</option>
                        <option value="dificil">Difícil</option>
                    </select>
                </label>
            </div>

            <!-- Se muestra solo si se elige "Nueva categoría" -->
            <div class="campos-categoria-nueva" hidden>
                <div class="fila-editor">
                    <label class="label-editor">
                        Nombre de la categoría
                        <input type="text" name="categoria_nueva" maxlength="40" placeholder="Ej: Astronomía">
                    </label>
                    <label class="label-editor label-chico">
                        Color
                        <input type="color" name="color_categoria" value="#ff6a00">
                    </label>
                </div>
            </div>

            <label class="label-editor">
                Respuesta correcta
                <input type="text" name="respuesta_correcta" required maxlength="300">
            </label>

            <label class="label-editor">
                Respuesta incorrecta 1
                <input type="text" name="incorrecta_1" required maxlength="300">
            </label>

            <label class="label-editor">
                Respuesta incorrecta 2
                <input type="text" name="incorrecta_2" required maxlength="300">
            </label>

            <label class="label-editor">
                Respuesta incorrecta 3
                <input type="text" name="incorrecta_3" required maxlength="300">
            </label>

            <div class="acciones-editor acciones-secundarias">
                <button type="submit" class="btn-jugar">{{#es_admin}}Agregar pregunta{{/es_admin}}{{^es_admin}}Enviar a aprobación{{/es_admin}}</button>
                <a href="{{base_url}}/editor/index" class="btn-secundario">Cancelar</a>
            </div>
        </form>
    </div>
</main>
