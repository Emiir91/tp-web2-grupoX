<main class="pantalla-resultados">
    <div class="panel-resultados">
        <div class="header-resultados">
            <h1>Resultados de la Partida</h1>
        </div>

        <div class="mensaje-final">
            <h2>{{mensaje}}</h2>
        </div>

        <div class="estadisticas">
            <div class="estadistica-item">
                <h3>Puntaje Final</h3>
                <p class="valor">{{puntaje}}</p>
            </div>

            <div class="estadistica-item">
                <h3>Racha Máxima</h3>
                <p class="valor">{{racha}}</p>
            </div>

            <div class="estadistica-item">
                <h3>Estado</h3>
                <p class="valor">{{estado}}</p>
            </div>
        </div>

        <div class="acciones">
            <a href="{{base_url}}/home/index" class="btn-jugar">⚡ VOLVER AL INICIO ⚡</a>
        </div>
    </div>
</main>

<script>
    history.pushState(null, null, location.href);

    window.addEventListener('popstate', function (event) {
        window.location.replace('{{base_url}}/home/index');
    });
</script>