<main class="pantalla-resultados">
    <div class="panel-resultados">
        <div class="header-resultados">
            <h1>Resultados de la Partida</h1>
        </div>

        <div class="mensaje-final">
            <h2>{{mensaje}}</h2>
        </div>

        <div class="estadisticas">
            <div class="estadistica-item">
                <h3>Puntaje Final</h3>
                <p class="valor">{{puntaje}}</p>
            </div>

            <div class="estadistica-item">
                <h3>Racha Máxima</h3>
                <p class="valor">{{racha}}</p>
            </div>

            <div class="estadistica-item">
                <h3>Estado</h3>
                <p class="valor">{{estado}}</p>
            </div>
        </div>

        <details class="revision-preguntas">
            <summary class="btn-ver-preguntas">Ver Preguntas</summary>
            <div class="lista-revision">
                {{#preguntas_partida}}
                <div class="item-revision" style="--color-categoria: {{color_categoria}};">
                    <div class="contenido-revision">
                        <span class="chip-categoria">{{categoria}}</span>
                        <p class="texto-pregunta">{{texto_pregunta}}</p>
                        <p class="respuesta-elegida {{#es_correcta}}correcta{{/es_correcta}}{{^es_correcta}}incorrecta{{/es_correcta}}">
                            Tu respuesta: {{respuesta_elegida}}
                        </p>
                        {{^es_correcta}}
                        <p class="respuesta-correcta">Correcta: {{respuesta_correcta}}</p>
                        {{/es_correcta}}
                    </div>
                    <button type="button" class="btn-reportar" data-id-pregunta="{{id_pregunta}}" data-texto="{{texto_pregunta}}" title="Reportar pregunta">🚩</button>
                </div>
                {{/preguntas_partida}}

                {{^preguntas_partida}}
                <p class="sin-preguntas">No se registraron preguntas en esta partida.</p>
                {{/preguntas_partida}}
            </div>
        </details>

        <div class="acciones">
            <!-- Nueva partida: por defecto con el mismo modo que la anterior; "Cambiar modo" permite elegir otro -->
            <form action="{{base_url}}/juego/iniciar" method="POST" class="form-nueva-partida">
                <input type="hidden" name="modo_juego" id="modo-nueva-partida" value="{{modo_juego}}">
                <button type="submit" class="btn-jugar">⚡ NUEVA PARTIDA ⚡</button>
            </form>
            <p class="texto-modo">Modo: <strong id="nombre-modo-elegido">{{nombre_modo}}</strong> · <button type="button" id="btn-cambiar-modo" class="link-cambiar-modo">Cambiar modo</button></p>
            <a href="{{base_url}}/lobby" class="btn-secundario">Volver al Lobby</a>
        </div>
    </div>
</main>

<!-- Ventanita para elegir otro modo: solo lo selecciona; la partida arranca recién con "Nueva partida" -->
<div id="modal-modo" class="modal-overlay modal-oculto">
    <div class="modal-caja">
        <h3>Elegí el modo</h3>
        <div class="selector-modos">
            {{#modos}}
            <button type="button" data-modo="{{valor}}" class="opcion-modo{{#activo}} activo{{/activo}}">{{texto}}</button>
            {{/modos}}
        </div>
        <div class="acciones-modal">
            <button id="btn-cancelar-modo" class="btn-secundario" type="button">Cancelar</button>
        </div>
    </div>
</div>

<div id="modal-reporte" class="modal-overlay modal-oculto">
    <div class="modal-caja">
        <h3>Reportar pregunta</h3>
        <p id="reporte-texto-pregunta" class="reporte-pregunta"></p>
        <select id="reporte-tipo" class="select-reporte">
            <option value="respuesta_incorrecta">❌ La respuesta correcta está mal</option>
            <option value="categoria_incorrecta">🏷️ Está en la categoría equivocada</option>
            <option value="mal_redactada">✏️ Está mal escrita o no se entiende</option>
            <option value="otro">💬 Otro</option>
        </select>
        <textarea id="reporte-motivo" rows="3" placeholder="Contanos más (opcional)..."></textarea>
        <p id="reporte-error" class="reporte-error confirmacion-oculta">Contanos cuál es el problema.</p>
        <div class="acciones-modal">
            <button id="btn-cancelar-reporte" class="btn-secundario" type="button">Cancelar</button>
            <button id="btn-enviar-reporte" class="btn-jugar" type="button">Enviar reporte</button>
        </div>
        <p id="reporte-confirmacion" class="confirmacion-oculta">✓ Reporte enviado. Gracias por avisarnos.</p>
    </div>
</div>

<script>
    history.pushState(null, null, location.href);

    window.addEventListener('popstate', function (event) {
        window.location.replace('{{base_url}}/lobby');
    });
</script>
<script>const BASE_URL = '{{base_url}}';</script>
<script src="{{base_url}}/public/js/resultados.js?v={{version_js}}"></script>
