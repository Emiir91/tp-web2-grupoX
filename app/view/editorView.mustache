<main class="pantalla-editor">
    <div class="panel-editor panel-amplio">
        <a href="{{base_url}}/home" class="btn-volver">← Volver al Home</a>
        <h2 class="titulo-editor">Panel de Editor</h2>
        <p class="subtitulo-editor">Hola <span>{{nombre_usuario}}</span>, administrá las preguntas del catálogo.</p>

        {{#alerta_exito}}<div class="alerta alerta-exito">{{alerta_exito}}</div>{{/alerta_exito}}
        {{#alerta_error}}<div class="alerta alerta-error">{{alerta_error}}</div>{{/alerta_error}}

        <div class="acciones-editor">
            <a href="{{base_url}}/editor/preguntas" class="btn-secundario">📋 Ver preguntas</a>
            <a href="{{base_url}}/editor/categorias" class="btn-secundario">🏷️ Ver categorías</a>
        </div>

        <section class="seccion-editor">
            <h3 class="titulo-seccion">Preguntas reportadas</h3>

            {{#reportes}}
            <div class="item-reporte">
                <div class="datos-reporte">
                    <p class="texto-reporte">{{texto_pregunta}}</p>
                    <p class="meta-reporte">Reportado por <strong>{{nombre_usuario}}</strong> · {{fecha}}</p>
                    <p class="motivo-reporte"><span class="tipo-reporte">{{nombre_tipo}}</span> <small>({{categoria}})</small></p>
                    {{#tiene_motivo}}<p class="motivo-reporte">"{{motivo}}"</p>{{/tiene_motivo}}
                </div>
                <div class="acciones-reporte">
                    <a href="{{base_url}}/editor/editarDesdeReporte?id={{id_reporte}}" class="btn-mini btn-editar">✏️ Editar</a>
                    <form action="{{base_url}}/editor/eliminarDesdeReporte" method="POST" class="form-inline">
                        <input type="hidden" name="id_reporte" value="{{id_reporte}}">
                        <button type="submit" class="btn-mini btn-eliminar">🗑️ Eliminar</button>
                    </form>
                    <form action="{{base_url}}/editor/desestimarReporte" method="POST" class="form-inline">
                        <input type="hidden" name="id_reporte" value="{{id_reporte}}">
                        <button type="submit" class="btn-mini btn-desestimar">✖ Desestimar</button>
                    </form>
                </div>
            </div>
            {{/reportes}}

            {{^reportes}}
            <p class="vacio">No hay preguntas reportadas pendientes.</p>
            {{/reportes}}
        </section>

        <section class="seccion-editor">
            <h3 class="titulo-seccion">Preguntas sugeridas por usuarios</h3>

            {{#sugeridas}}
            <div class="item-reporte">
                <div class="datos-reporte">
                    <p class="texto-reporte">{{texto_pregunta}}</p>
                    <p class="meta-reporte">{{categoria}} · {{dificultad}}</p>
                    <div class="respuestas-sugerencia">
                        {{#respuestas}}
                        <span class="respuesta-chip {{#es_correcta}}correcta{{/es_correcta}}">{{texto_respuesta}}</span>
                        {{/respuestas}}
                    </div>

                    {{#es_categoria_nueva}}
                    <!-- La sugerencia propone una categoría nueva: crearla (eligiendo el color) o usar una existente.
                         Los campos pertenecen al formulario "Aprobar" gracias al atributo form. -->
                    <div class="categoria-nueva-sugerida">
                        <p class="titulo-categoria-nueva">🆕 Propone una categoría nueva: <strong>{{categoria}}</strong></p>

                        {{#puede_crear_categoria}}
                        <label class="opcion-categoria">
                            <input type="radio" name="accion_categoria" value="crear" checked form="form-aprobar-{{id_pregunta}}">
                            Crear "{{categoria}}"
                        </label>
                        <div class="fila-categoria-nueva">
                            <label>Color
                                <input type="color" name="color_categoria" value="#ff6a00" form="form-aprobar-{{id_pregunta}}">
                            </label>
                        </div>

                        <label class="opcion-categoria">
                            <input type="radio" name="accion_categoria" value="existente" form="form-aprobar-{{id_pregunta}}">
                            Usar una existente:
                        </label>
                        {{/puede_crear_categoria}}
                        {{^puede_crear_categoria}}
                        <!-- No se puede crear: ya está propuesta o dada de baja. Se elige sí o sí una existente. -->
                        <p class="aviso-categoria">⚠️ {{aviso_categoria}}</p>
                        <input type="hidden" name="accion_categoria" value="existente" form="form-aprobar-{{id_pregunta}}">
                        <p class="opcion-categoria">Elegí una categoría existente:</p>
                        {{/puede_crear_categoria}}
                        <select name="categoria_existente" class="select-categoria-existente" form="form-aprobar-{{id_pregunta}}">
                            {{#categorias_activas}}
                            <option value="{{nombre}}">{{nombre}}</option>
                            {{/categorias_activas}}
                        </select>
                    </div>
                    {{/es_categoria_nueva}}
                </div>
                <div class="acciones-reporte">
                    <form id="form-aprobar-{{id_pregunta}}" action="{{base_url}}/editor/aprobarSugerencia" method="POST" class="form-inline">
                        <input type="hidden" name="id_pregunta" value="{{id_pregunta}}">
                        <button type="submit" class="btn-mini btn-aprobar">✓ Aprobar</button>
                    </form>
                    <form action="{{base_url}}/editor/rechazarSugerencia" method="POST" class="form-inline">
                        <input type="hidden" name="id_pregunta" value="{{id_pregunta}}">
                        <button type="submit" class="btn-mini btn-eliminar">✖ Rechazar</button>
                    </form>
                </div>
            </div>
            {{/sugeridas}}

            {{^sugeridas}}
            <p class="vacio">No hay preguntas sugeridas pendientes.</p>
            {{/sugeridas}}
        </section>
    </div>
</main>
