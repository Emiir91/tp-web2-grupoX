<main class="pantalla-editor">
    <div class="panel-editor panel-amplio">
        <h2 class="titulo-editor">Preguntas del catálogo</h2>

        {{#alerta_exito}}<div class="alerta alerta-exito">{{alerta_exito}}</div>{{/alerta_exito}}
        {{#alerta_error}}<div class="alerta alerta-error">{{alerta_error}}</div>{{/alerta_error}}

        <div class="acciones-editor acciones-secundarias">
            <a href="{{base_url}}/editor/index" class="btn-secundario">← Volver</a>
            <a href="{{base_url}}/editor/agregar" class="btn-jugar">➕ Agregar pregunta</a>
        </div>

        <!-- Filtros: se aplican solos al cambiar cualquier opción -->
        <form action="{{base_url}}/editor/preguntas" method="GET" class="barra-filtros">
            <select name="categoria" onchange="this.form.submit()" aria-label="Categoría">
                <option value="">Categoría: todas</option>
                {{#categorias}}
                <option value="{{nombre}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
                {{/categorias}}
            </select>
            <select name="dificultad" onchange="this.form.submit()" aria-label="Dificultad">
                <option value="">Dificultad: todas</option>
                {{#dificultades}}
                <option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
                {{/dificultades}}
            </select>
            <select name="estado" onchange="this.form.submit()" aria-label="Estado">
                <option value="">Estado: todos</option>
                {{#estados}}
                <option value="{{valor}}" {{#seleccionada}}selected{{/seleccionada}}>{{nombre}}</option>
                {{/estados}}
            </select>
            {{#hay_filtro}}<a href="{{base_url}}/editor/preguntas" class="limpiar-filtros" title="Quitar filtros">✖</a>{{/hay_filtro}}
            <noscript><button type="submit" class="btn-mini btn-editar">Filtrar</button></noscript>
        </form>

        <p class="contador-preguntas">{{total_preguntas}} pregunta(s)</p>

        {{^preguntas}}
        <p class="vacio">No hay preguntas que coincidan con esos filtros.</p>
        {{/preguntas}}

        {{#preguntas}}
        <div class="item-pregunta">
            <div class="datos-pregunta">
                <p class="texto-pregunta-item">{{texto_pregunta}}</p>
                <p class="meta-pregunta-item">{{categoria}} · {{dificultad}}</p>
                <span class="badge-estado badge-{{estado}}">{{estado}}</span>
            </div>
            <div class="acciones-pregunta">
                {{#puede_editar}}
                <a href="{{base_url}}/editor/editar?id={{id_pregunta}}" class="btn-mini btn-editar">✏️ Editar</a>
                {{/puede_editar}}
                {{#puede_eliminar}}
                <form action="{{base_url}}/editor/eliminar" method="POST" class="form-inline">
                    <input type="hidden" name="id_pregunta" value="{{id_pregunta}}">
                    <button type="submit" class="btn-mini btn-eliminar">🗑️ Eliminar</button>
                </form>
                {{/puede_eliminar}}
                {{#puede_reactivar}}
                <form action="{{base_url}}/editor/reactivar" method="POST" class="form-inline">
                    <input type="hidden" name="id_pregunta" value="{{id_pregunta}}">
                    <button type="submit" class="btn-mini btn-aprobar">♻️ Reactivar</button>
                </form>
                {{/puede_reactivar}}
                {{#reactivar_bloqueado}}
                <span class="btn-mini btn-deshabilitado" title="La categoría «{{categoria}}» está dada de baja: reactivá la categoría primero">♻️ Reactivar</span>
                {{/reactivar_bloqueado}}
            </div>
        </div>
        {{/preguntas}}

        {{#mostrar_paginacion}}
        <nav class="paginacion">
            <p class="paginacion-info">Página {{pagina_actual}} de {{total_paginas}}</p>
            <div class="paginacion-botones">
                {{#tiene_anterior}}
                <a href="?pagina=1{{{query_filtros}}}" class="pagina-link" title="Primera página">&laquo;</a>
                <a href="?pagina={{pagina_anterior}}{{{query_filtros}}}" class="pagina-link">← Anterior</a>
                {{/tiene_anterior}}
                {{#paginas}}
                <a href="?pagina={{numero}}{{{query_filtros}}}" class="pagina-num {{#activa}}activa{{/activa}}">{{numero}}</a>
                {{/paginas}}
                {{#tiene_siguiente}}
                <a href="?pagina={{pagina_siguiente}}{{{query_filtros}}}" class="pagina-link">Siguiente →</a>
                <a href="?pagina={{total_paginas}}{{{query_filtros}}}" class="pagina-link" title="Última página">&raquo;</a>
                {{/tiene_siguiente}}
            </div>
        </nav>
        {{/mostrar_paginacion}}
    </div>
</main>
