<header class="barra-superior">
    <div class="barra-logo">
        <a href="{{base_url}}/home">
            <img src="{{base_url}}/public/img/logotipo2.png" alt="Cortocircuito" class="logo-nav">
        </a>
    </div>

    <div class="barra-opciones">
        {{#usuario_logueado}}
        {{#es_editor}}
        <a href="{{base_url}}/editor/index" class="btn-nav-panel">📝 Editor{{#hay_pendientes_editor}}<span class="badge-notificacion" title="{{pendientes_editor_titulo}}">{{pendientes_editor}}</span>{{/hay_pendientes_editor}}</a>
        {{/es_editor}}
        {{#es_admin}}
        <a href="{{base_url}}/admin/index" class="btn-nav-panel">🛡️ Admin{{#hay_pendientes_admin}}<span class="badge-notificacion" title="{{pendientes_admin_titulo}}">{{pendientes_admin}}</span>{{/hay_pendientes_admin}}</a>
        {{/es_admin}}
        <div class="menu-perfil-contenedor">
            <button id="btn-perfil" class="btn-icono-perfil">
                👤 {{nombre_usuario}} ▼
            </button>

            <div id="menu-desplegable" class="dropdown-oculto">
                <a href="{{base_url}}/perfil">Mi Perfil</a>
                <a href="{{base_url}}/login/logout" class="cerrar-sesion">Cerrar Sesión</a>
            </div>
        </div>
        {{/usuario_logueado}}

        {{^usuario_logueado}}
        {{^en_login}}
        <a href="{{base_url}}/login" class="btn-iniciar-sesion">Iniciar Sesión</a>
        {{/en_login}}
        {{/usuario_logueado}}
    </div>
</header>
