<main class="pantalla-perfil">
    <div class="panel-perfil">

        {{#perfil_no_encontrado}}
        <div class="encabezado-perfil">
            <h2>Jugador <span>no encontrado</span></h2>
            <p class="subtitulo-perfil">El perfil que buscás no existe o todavía no activó su cuenta.</p>
            <a href="{{base_url}}/home" class="btn-volver-perfil">Volver al inicio</a>
        </div>
        {{/perfil_no_encontrado}}

        {{#perfil}}
        <a href="{{base_url}}/lobby" class="btn-volver-lobby">← Volver al Lobby</a>
        <!--
            Todos los bloques del perfil son hermanos dentro de .perfil-layout:
            - Celular: uno debajo del otro (encabezado, estadísticas, datos, mapa, QR).
            - PC: grilla con arriba encabezado | estadísticas | QR chico, y abajo datos | mapa.
        -->
        <div class="perfil-layout">

            <div class="encabezado-perfil">
                <img src="{{base_url}}/{{foto_perfil}}" alt="Foto de perfil" class="foto-perfil">
                <div class="textos-encabezado">
                    <h2>Perfil de <span>{{nombre_usuario}}</span></h2>
                    {{#es_propio}}<p class="subtitulo-perfil">Acá podés revisar tu información personal.</p>{{/es_propio}}
                    {{^es_propio}}<p class="subtitulo-perfil">Mirá cómo le viene yendo a este jugador.</p>{{/es_propio}}
                </div>
            </div>

            <!-- Estadísticas del jugador -->
            <div class="estadisticas-perfil">
                <div class="caja-estadistica">
                    <span class="valor-estadistica">{{puntaje_total}}</span>
                    <span class="etiqueta-estadistica">Puntaje total</span>
                </div>
                <div class="caja-estadistica">
                    <span class="valor-estadistica">{{cantidad_partidas}}</span>
                    <span class="etiqueta-estadistica">Partidas jugadas</span>
                </div>
            </div>

            <!-- Datos del usuario -->
            <div class="columna-datos">
                <div class="grupo-input">
                    <label>Nombre Completo</label>
                    <div class="dato-valor">{{nombre_completo}}</div>
                </div>

                {{#es_propio}}
                <div class="grupo-input">
                    <label>Correo Electrónico</label>
                    <div class="dato-valor">{{mail}}</div>
                </div>
                {{/es_propio}}

                <div class="grupo-input">
                    <label>Año de Nacimiento</label>
                    <div class="dato-valor">{{anio_nacimiento}}</div>
                </div>

                <div class="grupo-input">
                    <label>Sexo</label>
                    <div class="dato-valor">{{sexo}}</div>
                </div>

                <div class="grupo-input">
                    <label>Nombre de Usuario</label>
                    <div class="dato-valor">{{nombre_usuario}}</div>
                </div>

                <div class="grupo-input">
                    <label>País / Ciudad</label>
                    <div class="dato-valor">{{pais}}, {{ciudad}}</div>
                </div>
            </div>

            <!-- Mapa -->
            <div class="columna-mapa">
                <div class="grupo-input full-width-mapa">
                    <label>{{#es_propio}}Tu Ubicación de Registro{{/es_propio}}{{^es_propio}}Ubicación{{/es_propio}}</label>
                    <div id="mapa-perfil" class="mapa-contenedor" data-pais="{{pais}}" data-ciudad="{{ciudad}}"></div>
                </div>
            </div>

            <!-- Código QR: lleva al perfil público de este jugador -->
            <div class="columna-qr">
                <div class="grupo-input full-width-qr mt-3 text-center">
                    <label>Código QR del Perfil</label>
                    <div class="qr-contenedor p-2 rounded d-flex justify-content-center align-items-center">
                        <a href="{{url_perfil_publico}}" title="Abrir el perfil público">
                            <img src="{{url_qr}}"
                                 alt="Código QR del perfil de {{nombre_usuario}}"
                                 class="img-fluid rounded shadow-sm"
                                 style="background: white; padding: 8px; border-radius: 8px;">
                        </a>
                    </div>
                    <p class="texto-qr">Escanealo para abrir el perfil desde el celular</p>
                </div>
            </div>

        </div>
        {{/perfil}}

    </div>
</main>
